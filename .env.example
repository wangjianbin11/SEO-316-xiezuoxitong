# SEO Content Generator - 环境变量配置模板
# 复制此文件为 .env 并填写实际值

# ==================== LLM API 配置 ====================
# OpenAI 兼容 API (推荐使用 OpenRouter 或其他中转服务)
OPENAI_API_BASE=https://openrouter.ai/api/v1
OPENAI_API_KEY=your_openrouter_key_here
OPENAI_MODEL=anthropic/claude-sonnet-4-5

# ==================== Google Search API ====================
GOOGLE_SEARCH_API_KEY=your_google_api_key
GOOGLE_SEARCH_ENGINE_ID=your_search_engine_id

# ==================== WordPress 配置 ====================
WORDPRESS_SITE_URL=https://asgdropshipping.com
WORDPRESS_USERNAME=your_username
WORDPRESS_APP_PASSWORD=your_app_password

# ==================== 图片生成 API ====================
IMAGE_API_BASE=https://openrouter.ai/api/v1
IMAGE_API_KEY=your_image_api_key
IMAGE_MODEL=openai/dall-e-3

# ==================== DataForSEO 配置(新增) ====================
# 获取真实关键词数据(搜索量、KD、CPC)
# 注册地址: https://dataforseo.com/
DATAFORSEO_USERNAME=your_email@example.com
DATAFORSEO_PASSWORD=your_dataforseo_password
DATAFORSEO_LOCATION_CODE=2840

# ==================== 质量控制配置(新增) ====================
MIN_PUBLISH_SCORE=75
ALLOW_FORCE_PUBLISH=false

# ==================== 向量搜索配置(新增,可选) ====================
USE_VECTOR_SEARCH=false
VECTOR_DB_PATH=./chroma_db

# ==================== 站点信息配置(新增) ====================
AUTHOR_NAME=Janson
SITE_NAME=ASG Dropshipping
SITE_URL=https://asgdropshipping.com

# ==================== 应用配置 ====================
LOG_LEVEL=INFO
OUTPUT_DIR=outputs
TRACKER_DB_PATH=./seo_tracker.db
